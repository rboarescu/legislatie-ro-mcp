{
  // Configurare Cloudflare Workers (Workers Builds din GitHub foloseste acest fisier).
  // "name" trebuie sa fie identic cu "Project name" din dashboard-ul Cloudflare.
  // Secretul ACCESS_TOKEN NU se pune aici: se seteaza din Settings -> Variables and Secrets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "legislatie-ro-mcp",
  "main": "cloudflare-worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  // legislatie.just.ro refuza conexiunile HTTPS din afara Europei (Cloudflare raspunde atunci cu HTTP 520).
  // Un client din SUA (ex. Gemini in cloud) ar rula Worker-ul in SUA; il fixam in Frankfurt.
  "placement": { "region": "aws:eu-central-1" },
  // Necesar pentru build-urile de preview pe alte branch-uri (npx wrangler preview).
  "previews": {}
}
